# ============ LLM（必填）============
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ============ 向量 / 检索 ============
# 向量库后端：qdrant（默认）| chroma | local
# 换后端不需要改代码，只改这一行 —— 三个后端的行为契约由 tests/test_stores.py 保证。
# 选型说明见 app/ingest/stores.py 顶部注释与 README §2。
VECTOR_BACKEND=qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=ops_kb
QDRANT_DISTANCE=Cosine
# Chroma 仅在 VECTOR_BACKEND=chroma 时生效。
# CHROMA_PERSIST_DIR 非空 → 嵌入式单机模式（无需起容器，最省事）；
# 留空 → 连 CHROMA_HOST:CHROMA_PORT 的独立服务。
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_PERSIST_DIR=
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
RERANKER_MODEL=BAAI/bge-reranker-base
TOP_K_RETRIEVE=20
TOP_K_RERANK=5
# 重排总开关。实测 CrossEncoder 在纯 CPU 上候选池 20 时单题约 29.6s
# （python -m scripts.bench_rerank）。跑压测或 3 分钟演示时设 false，
# 关掉后走"融合序 + 文档多样性约束"，且会在 SSE 里如实标注
# degraded=rerank:disabled —— 报告指标时必须一并说明用的是哪条链路。
RERANK_ENABLED=true

# ============ 三层记忆（会话 + 长期事实；工作记忆 = LangGraph state）============
# 总开关：记忆是"锦上添花"的依赖，出问题先整层关；压测用它把记忆层排除在测量外。
SESSION_MEMORY_ENABLED=true
# 会话历史保留 24h，注入 prompt 的最近轮数（滑窗，不是日志）
SESSION_TTL_SECONDS=86400
SESSION_MAX_TURNS=10
# 长期事实 7 天、每会话上限 20 条（防 prompt 膨胀）
FACTS_TTL_SECONDS=604800
FACTS_MAX=20

# ============ 缓存（本次新增的核心能力）============
# 宿主机脚本连的地址。容器内由 docker-compose 的 environment 显式覆盖成服务名
# （REDIS_HOST=redis / REDIS_PORT=6379），所以这里的 localhost 只影响
# "在宿主机直接跑 python -m scripts.xxx"的场景，两者不会互相干扰。
# 端口 16379 是刻意错开的：本机若装过老版本 Redis（Windows 服务），它会占着
# 0.0.0.0:6379，而 Redis 6.0 以下不支持 HELLO、也没有 RediSearch —— 连过去会让
# 入库的版本号同步失败、语义缓存整层静默失效。ops-redis 容器的宿主映射即 16379。
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_DB=0
# RESP 协议版本：保持 2，不要改成 3。
# redis-py >= 6 默认走 RESP3（连接先发 HELLO 3），有两个后果：
#   1. Redis < 6.0 直接握手失败：ResponseError: unknown command 'HELLO'
#   2. RediSearch 返回结构从扁平数组变成结构化 map，而 _parse_search_reply
#      是按扁平数组写的 → 返回空候选，语义缓存永远 miss 且几乎不报错
# 详见 app/core/config.py 中 redis_protocol 的注释。
# REDIS_PROTOCOL=2
# 精确缓存 TTL：稳定知识可以给到 24h
CACHE_EXACT_TTL=86400
# 语义缓存 TTL：比精确缓存短，因为误命中代价更高
CACHE_SEMANTIC_TTL=21600
# 语义命中阈值：余弦相似度。运维/法律这类"数字敏感"场景建议 ≥0.96
CACHE_SEMANTIC_THRESHOLD=0.96
# 子链路缓存 TTL（秒）
CACHE_REWRITE_TTL=86400
CACHE_RERANK_TTL=21600
# MCP 工具结果 TTL：动态数据必须短，否则"时效性"就没了
CACHE_TOOL_TTL=30
# TTL 抖动比例，防缓存雪崩
CACHE_TTL_JITTER=0.1
# 空结果缓存 TTL，防穿透
CACHE_NULL_TTL=60

# ============ 安全沙箱（写操作人工确认）============
# 关闭 ≠ 放行：关掉之后写工具**一律拒绝**（fail-closed）。
# 语义是"更严"而不是"放行"，否则一次误操作就能把闸门关掉。
SANDBOX_ENABLED=true
# 待确认动作的存活时间（秒）。10 分钟够一个人看到消息再回来点确认；
# 太长会让"三天前那条确认"继续有效 —— 那时的上下文早变了。
SANDBOX_PENDING_TTL=600
# 审计日志（写/危险动作 + 被拒绝的调用，一行一个 JSON）
SANDBOX_AUDIT_PATH=data/audit/sandbox.jsonl

# ============ 知识库版本（缓存失效的总开关）============
# 每次知识库更新后 +1，所有缓存 key 自动失效 —— 不需要批量 DEL
# 注意：入库脚本会把新版本号写到 data/index/kb_version.json 并同步 Redis；
#       容器里的 KB_VERSION 必须与之一致，否则服务端会读到旧版本。
KB_VERSION=1
PROMPT_VERSION=v1

# ============ 知识库入库 ============
KB_RAW_DIR=data/raw
KB_INDEX_DIR=data/index

# OCR 通道：transcript = 离线回放（默认，无需联网；等价于 OCR 完美识别的 ground truth）
#            rapidocr   = 真实 OCR（需 pip install rapidocr-onnxruntime，首次运行下载模型）
OCR_PROVIDER=transcript
# 截图结构化描述：rule = 规则抽取（默认，离线）；vision = 多模态 LLM（需 API Key + 联网）
CAPTION_PROVIDER=rule
VISION_MODEL=deepseek-chat

# 切块参数（改这些会改变召回率，属于实验变量，必须记进实验台账）
# 上限 460 是倒推出来的：embedding 模型 max_seq_length=512，中文约 1 token/字
CHUNK_MAX_CHARS=460
CHUNK_MERGE_MIN_CHARS=80
CHUNK_OVERLAP_CHARS=80
INGEST_EMBED_BATCH=16
INGEST_BATCH_SIZE=64

# ============ 外部系统（Java MCP Server）============
MCP_SERVER_URL=http://java-mcp:8080
MCP_ENABLED=true

# ---- 韧性：熔断 / 重试 / 降级 ----
# 顺序 breaker(外) → retry(内)：只有"重试用尽仍失败"才计一次熔断失败
MCP_RETRY_MAX_ATTEMPTS=3
MCP_RETRY_BASE_DELAY=0.1        # 退避 100ms → 200ms → 400ms（带 20% 抖动）
MCP_RETRY_MAX_DELAY=1.0
MCP_RETRY_JITTER=0.2
MCP_CB_FAIL_THRESHOLD=5         # 连续 5 次最终失败才开（取 5 而非 3：并发下 3 容易误熔断）
MCP_CB_COOL_DOWN=15             # 冷却 15s：够下游重启一次；太短会反复开合
MCP_CB_HALF_OPEN_MAX=1          # 半开只放 1 个探测，避免恢复瞬间把下游再打垮

# ---- 故障注入（演示熔断/重试用，平时留空）----
# 值会作为 X-Chaos 头发给 Java MCP（见 java-mcp/ChaosFilter.java）：
#   sleep=1200          每次调用卡 1.2s → 触发客户端 2s 超时与重试
#   error=500           恒定 500 → 重试 3 次用尽 → 连续 5 次后熔断
#   error=500,times=2   前 2 次 500，第 3 次成功 → 演示"重试救回来"
# 注意：改了要重启 api 容器（.env 只在启动时注入）
MCP_CHAOS=

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root123
MYSQL_DATABASE=ops_ticket

# ============ 可观测 ============
# 三个开关分工（别混）：
#   OBSERVABILITY_ENABLED  埋点总闸（关掉 = 不建 span、不落盘）
#   OBSERVABILITY_TRACE_DIR 本地 JSONL 明细（**全量**，不采样；会话回放的事实源）
#   LANGFUSE_ENABLED        是否上报云端（还需下面两个 key 都非空）
OBSERVABILITY_ENABLED=true
OBSERVABILITY_TRACE_DIR=data/traces
# 采样只作用于云端上报。本地永远全量 —— 否则"回放某次失败请求"变成碰运气。
OBSERVABILITY_SAMPLE_RATE=1.0
OBSERVABILITY_TAGS=ops-agent
APP_ENVIRONMENT=dev
APP_RELEASE=

# 方案 A：Langfuse Cloud（最省时间，免费额度够个人项目）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# 方案 B：自托管 —— 用官方仓库的 compose 起，然后把 host 指向它
# LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_ENABLED=true
# 单次 HTTP 超时 / 构造等待上限 / 批量参数
LANGFUSE_TIMEOUT=5.0
# 构造实测在 Windows 宿主 10~51s 不等（SDK 5.0.1）、容器内 0.6s（5.0.2）。
# 超过这个值就放弃上报，本地照常 —— 启动时间不能被可选依赖拖住。
LANGFUSE_INIT_TIMEOUT=10.0
LANGFUSE_FLUSH_AT=64
LANGFUSE_FLUSH_INTERVAL=2.0

# ============ 应用 ============
LOG_LEVEL=INFO
API_KEY=demo-key-change-me
RATE_LIMIT_PER_MINUTE=120
