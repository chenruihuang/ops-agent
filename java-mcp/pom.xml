<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.4</version>
    <relativePath/>
  </parent>

  <groupId>com.opsagent</groupId>
  <artifactId>java-mcp</artifactId>
  <version>1.0.0</version>
  <name>ops-agent-mcp-server</name>
  <description>运维问答 Agent 的 MCP 工具服务（JSON-RPC 2.0 over HTTP）</description>

  <properties>
    <java.version>17</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- 只需要 Web：HTTP + Jackson -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Actuator + Prometheus registry。
         为什么最后还是引了它：monitoring/prometheus.yml 早就配了
         scrape `java-mcp:8080/actuator/prometheus`，没有这两个依赖时那个
         target 会一直是 DOWN —— 大盘上"Java 工具服务"整块空白，
         看起来像没接入，实际是抓取地址根本不存在。
         指标口径必须和 Python 侧对齐：调用次数按 (tool, result) 分，
         耗时分位用 Histogram（否则只能报平均值，P95 无从谈起）。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
