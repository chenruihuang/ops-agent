      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "无流量（窗口内没有请求）"
        },
        "overrides": []
      },
      "options": {},
      "description": "成本指标。命中一次就省一次完整 prompt 的 token —— 报「缓存有用」时用它，而不是只报命中率。"
    },
    {
